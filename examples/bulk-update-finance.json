{
  "name": "finance_transactions_update_strict",
  "operation": "mutate",
  "schema_version": "1.0",
  "connection": {
    "driver": "postgres",
    "dsn_env": "PIPECORE_PG_DSN"
  },
  "target": {
    "schema": "public",
    "table": "finance_transactions"
  },
  "excel": {
    "format": "xlsx",
    "sheet": "Updates",
    "header_row": 1,
    "first_data_row": 2,
    "header_policy": "exact_order",
    "reject_unknown_columns": true
  },
  "fields": [
    {
      "excel": "Transaction ID",
      "column": "transaction_id",
      "type": "string",
      "required": true,
      "max_length": 40
    },
    {
      "excel": "Event Time",
      "column": "event_time",
      "type": "datetime",
      "required": true,
      "date_format": "%Y-%m-%d %H:%M:%S%.f"
    },
    {
      "excel": "Balance After",
      "column": "balance_after",
      "type": "decimal",
      "required": true,
      "precision": 24,
      "scale": 4,
      "excel_storage": "text"
    },
    {
      "excel": "Reconciled",
      "column": "is_reconciled",
      "type": "boolean",
      "required": true
    }
  ],
  "validation": {
    "strict": true,
    "reject_formulas": true,
    "reject_duplicate_keys": true,
    "max_error_samples": 20,
    "decimal_conversion": "reject_loss"
  },
  "execution": {
    "atomic": true,
    "memory_limit_mb": 512,
    "batch_rows": 10000,
    "temp_dir": "./tmp",
    "error_report_format": "jsonl"
  },
  "mutation": {
    "mode": "update_strict",
    "match": {
      "keys": [
        "transaction_id"
      ],
      "must_match_all": true,
      "require_unique_index": true
    },
    "sets": [
      {
        "target": "balance_after",
        "source": "balance_after",
        "operation": "replace"
      },
      {
        "target": "is_reconciled",
        "source": "is_reconciled",
        "operation": "replace"
      },
      {
        "target": "event_time",
        "source": "event_time",
        "operation": "replace"
      }
    ],
    "isolation": "serializable",
    "max_serialization_retries": 2
  }
}
